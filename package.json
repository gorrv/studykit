{
  "name": "studykit",
  "version": "1.0.0",
  "description": "Self-contained interactive revision notes: computable tools, generated self-marking questions, and a mock exam, in one HTML file per module.",
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node tests/run.js",
    "test:only": "node tests/run.js",
    "serve": "node build.js && node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{const u=q.url==='/'?'/index.html':q.url.split('?')[0];const t=p.join(__dirname,'dist',decodeURIComponent(u));f.readFile(t,(e,d)=>e?(s.writeHead(404),s.end('not found')):(s.writeHead(200,{'content-type':u.endsWith('.html')?'text/html':'text/plain'}),s.end(d)));}).listen(8080,()=>console.log('dist/ on http://localhost:8080'))\""
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  },
  "license": "MIT",
  "private": true
}
